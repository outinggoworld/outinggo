# ============================================================
#  OUTINGO — Environment Variables
#  File: .env  (NEVER commit this to GitHub!)
#  Copy this file and fill in your real values
# ============================================================

# ─── SERVER ───────────────────────────────────
PORT=3000

# ─── FIREBASE ─────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
FIREBASE_DB_URL=https://outingo-default-rtdb.firebaseio.com
# ─── RAZORPAY ─────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── WHATSAPP (Meta Business API) ─────────────
# Get from: https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=outingo_webhook_secret_2025

# ─── ADMIN ────────────────────────────────────
# Your WhatsApp number to receive booking alerts
ADMIN_PHONE=9999999999
